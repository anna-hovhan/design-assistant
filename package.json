{
  "name": "design-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My personal design assistant: generates on-brand visual assets from the CLI or Claude Code.",
  "bin": { "design": "./bin/design.mjs" },
