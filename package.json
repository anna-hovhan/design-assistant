{
  "name": "design-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My personal design assistant: generates on-brand visual assets from the CLI or Claude Code.",
  "bin": {
    "design": "./bin/design.mjs"
  },
  "scripts": {
    "design": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:fonts": "tsx scripts/build-fontdata.ts"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@types/node": "^22.0.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
